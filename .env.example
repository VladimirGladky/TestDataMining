# --- Прокси (обязательно) ---
# Все HTTP-запросы (включая headless Chrome для прохождения Qrator) идут через
# этот прокси. Формат: scheme://user:pass@host:port  или  scheme://host:port
PROXY_URL=

# --- Магазин (обязательно) ---
# Подстрока в адресе магазина, названии (ТК639) или alias (0639). Регистр
# не важен. Должна однозначно опознавать один магазин в выбранном городе —
# при нескольких совпадениях парсер падает со списком и просит уточнить.
# Примеры: "Можайское ш., 39", "ТК639", "0639", "Гурьянова".
LENTA_STORE=

# --- Категории (обязательно) ---
# Числовые selectionId, через запятую. Берутся из URL категории на сайте:
#   https://lenta.com/catalog/frukty-310002385
# → 310002385.
LENTA_SELECTION_IDS=310002385,310003460

# Опционально: ID→название (фолбэк, если API не вернёт selectionGroups[0].name).
LENTA_SELECTION_NAMES=310002385:Фрукты,310003460:Хлеб и булочки

# --- Опционально ---
# LENTA_DOMAIN=moscow
# LENTA_DELIVERY_MODE=pickup
# LENTA_PAGE_LIMIT=40
# LENTA_BOOTSTRAP_WAIT_SECONDS=12      # сколько ждать после Navigate в headless
# LENTA_USER_AGENT=...                 # по умолчанию — современный Chrome
# REQUEST_TIMEOUT_SECONDS=30
# RETRY_ATTEMPTS=3
